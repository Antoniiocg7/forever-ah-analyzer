# Copia este archivo a .env.local y rellénalo. .env.local NO se sube al repo.

# https://develop.battle.net → Create Client
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
# Opcional: si se deja vacío se usa el primer ruleset del índice (hoy no filtra nada).
BLIZZARD_RULESET_ID=

# Supabase → Project Settings → API
SUPABASE_URL=
# Service role key: solo en servidor / scripts. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña que pide /admin/houses para guardar cambios (invéntate una larga).
ADMIN_TOKEN=

# Telegram (opcional): token de @BotFather para las alertas. Luego: pnpm telegram-setup
TELEGRAM_BOT_TOKEN=
